{
  "version": 2,
  "rewrites": [
    {
      "source": "/nexhack1",
      "destination": "/nexhack1/index.html"
    },
    {
      "source": "/nexhack1/(.*)",
      "destination": "/nexhack1/index.html"
    },
    {
      "source": "/nexhack",
      "destination": "/nexhack/index.html"
    },
    {
      "source": "/nexhack/(.*)",
      "destination": "/nexhack/index.html"
    },
    {
      "source": "/nexhack2",
      "destination": "/nexhack2/index.html"
    },
    {
      "source": "/nexhack2/(.*)",
      "destination": "/nexhack2/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}